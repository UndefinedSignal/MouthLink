{
  "version": 1,
  "about": "MouthLink face calibration catalog. Shared by MouthLink.Receiver (--prompts face) and tools/mlrec_pair.py (--face). Each item: what to say, how long to hold, how long to wait before labelling (settle: reaction + reaching the pose), and target values for channels. Channels are the 33 stock PICO mouth slots, TongueLeft/Right/Up/Down, and channels the stock model does not have (new_channels). Unlisted new channels and tongue directions are 0 inside an item when zero_new is true (default); unlisted stock channels keep the stock value. Left/right are the user's own sides.",
  "new_channels": ["CheekPuffLeft", "CheekPuffRight", "CheekSuckLeft", "CheekSuckRight",
                   "MouthTightenerLeft", "MouthTightenerRight", "TongueRoll"],
  "intro": {"ru": "Калибровка лица. Делай каждое выражение и держи его, пока не скажу расслабиться. Влево и вправо — в свою сторону. Начинаем.",
            "en": "Face calibration. Make each expression and hold it until I say relax. Left and right are your own sides. Starting.",
            "seconds": 7},
  "rest": {"id": "neutral", "ru": "Расслабь лицо", "en": "Relax your face", "seconds": 2.5},
  "defaults": {"hold": 4.0, "settle": 0.8, "tail": 0.2, "zero_new": true},
  "items": [
    {"id": "jaw_open", "group": "jaw", "ru": "Открой рот широко", "en": "Open your mouth wide",
     "labels": {"JawOpen": 1}},
    {"id": "jaw_open_half", "group": "jaw", "ru": "Открой рот наполовину", "en": "Open your mouth halfway",
     "hold": 4.5, "settle": 1.0, "labels": {"JawOpen": 0.5}},
    {"id": "jaw_left", "group": "jaw", "ru": "Челюсть влево", "en": "Jaw to the left",
     "hold": 5, "settle": 1.2, "labels": {"JawLeft": 1, "JawRight": 0}},
    {"id": "jaw_right", "group": "jaw", "ru": "Челюсть вправо", "en": "Jaw to the right",
     "hold": 5, "settle": 1.2, "labels": {"JawRight": 1, "JawLeft": 0}},
    {"id": "jaw_forward", "group": "jaw", "ru": "Челюсть вперёд", "en": "Jaw forward",
     "hold": 5, "settle": 1.2, "labels": {"JawForward": 1}},
    {"id": "mouth_close", "group": "jaw", "ru": "Опусти челюсть, но губы держи сомкнутыми", "en": "Drop your jaw but keep your lips closed",
     "hold": 5, "settle": 1.8, "labels": {"MouthClose": 1}},

    {"id": "pucker", "group": "lips", "ru": "Губы трубочкой, как для поцелуя", "en": "Pucker your lips like a kiss",
     "labels": {"MouthPucker": 1, "MouthFunnel": 0}},
    {"id": "funnel", "group": "lips", "ru": "Губы воронкой, как на звук О", "en": "Funnel your lips like an O",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthFunnel": 1}},
    {"id": "mouth_left", "group": "lips", "ru": "Сдвинь губы влево", "en": "Move your lips to the left",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthLeft": 1, "MouthRight": 0}},
    {"id": "mouth_right", "group": "lips", "ru": "Сдвинь губы вправо", "en": "Move your lips to the right",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthRight": 1, "MouthLeft": 0}},
    {"id": "press", "group": "lips", "ru": "Плотно сожми губы", "en": "Press your lips together firmly",
     "labels": {"MouthPressL": 1, "MouthPressR": 1, "JawOpen": 0}},
    {"id": "tighten", "group": "lips", "ru": "Напряги и сузь губы, как в недовольном хм", "en": "Tighten and narrow your lips, like a displeased hmm",
     "hold": 5, "settle": 1.5, "labels": {"MouthTightenerLeft": 1, "MouthTightenerRight": 1}},
    {"id": "tighten_left", "group": "lips", "ru": "Напряги губы только слева", "en": "Tighten your lips on the left side only",
     "hold": 6, "settle": 2.0, "labels": {"MouthTightenerLeft": 1, "MouthTightenerRight": 0}},
    {"id": "tighten_right", "group": "lips", "ru": "Напряги губы только справа", "en": "Tighten your lips on the right side only",
     "hold": 6, "settle": 2.0, "labels": {"MouthTightenerRight": 1, "MouthTightenerLeft": 0}},
    {"id": "roll_lower", "group": "lips", "ru": "Подверни нижнюю губу внутрь", "en": "Roll your lower lip in",
     "hold": 5, "settle": 1.2, "labels": {"MouthRollLower": 1}},
    {"id": "roll_upper", "group": "lips", "ru": "Подверни верхнюю губу внутрь", "en": "Roll your upper lip in",
     "hold": 5, "settle": 1.5, "labels": {"MouthRollUpper": 1}},
    {"id": "roll_both", "group": "lips", "ru": "Спрячь обе губы внутрь", "en": "Roll both lips in",
     "hold": 5, "settle": 1.5, "labels": {"MouthRollUpper": 1, "MouthRollLower": 1}},
    {"id": "shrug_lower", "group": "lips", "ru": "Выпяти нижнюю губу, как в обиде", "en": "Push your lower lip out, like pouting",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthShrugLower": 1}},
    {"id": "shrug_upper", "group": "lips", "ru": "Выпяти верхнюю губу", "en": "Push your upper lip out",
     "hold": 5, "settle": 1.5, "labels": {"MouthShrugUpper": 1}},
    {"id": "upper_up", "group": "lips", "ru": "Подними верхнюю губу и покажи верхние зубы", "en": "Raise your upper lip and show your upper teeth",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthUpperUpL": 1, "MouthUpperUpR": 1}},
    {"id": "upper_up_left", "group": "lips", "ru": "Подними верхнюю губу только слева", "en": "Raise your upper lip on the left side only",
     "hold": 6, "settle": 2.0, "labels": {"MouthUpperUpL": 1, "MouthUpperUpR": 0}},
    {"id": "upper_up_right", "group": "lips", "ru": "Подними верхнюю губу только справа", "en": "Raise your upper lip on the right side only",
     "hold": 6, "settle": 2.0, "labels": {"MouthUpperUpR": 1, "MouthUpperUpL": 0}},
    {"id": "lower_down", "group": "lips", "ru": "Опусти нижнюю губу и покажи нижние зубы", "en": "Lower your lower lip and show your lower teeth",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthLowerDownL": 1, "MouthLowerDownR": 1}},
    {"id": "lower_down_left", "group": "lips", "ru": "Опусти нижнюю губу только слева", "en": "Lower your lower lip on the left side only",
     "hold": 6, "settle": 2.0, "labels": {"MouthLowerDownL": 1, "MouthLowerDownR": 0}},
    {"id": "lower_down_right", "group": "lips", "ru": "Опусти нижнюю губу только справа", "en": "Lower your lower lip on the right side only",
     "hold": 6, "settle": 2.0, "labels": {"MouthLowerDownR": 1, "MouthLowerDownL": 0}},

    {"id": "smile", "group": "corners", "ru": "Широкая улыбка", "en": "Big smile",
     "labels": {"MouthSmileL": 1, "MouthSmileR": 1, "MouthFrownL": 0, "MouthFrownR": 0}},
    {"id": "smile_half", "group": "corners", "ru": "Лёгкая улыбка", "en": "Slight smile",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthSmileL": 0.5, "MouthSmileR": 0.5}},
    {"id": "smile_left", "group": "corners", "ru": "Улыбка только левой стороной", "en": "Smile with the left side only",
     "hold": 6, "settle": 2.0, "labels": {"MouthSmileL": 1, "MouthSmileR": 0}},
    {"id": "smile_right", "group": "corners", "ru": "Улыбка только правой стороной", "en": "Smile with the right side only",
     "hold": 6, "settle": 2.0, "labels": {"MouthSmileR": 1, "MouthSmileL": 0}},
    {"id": "frown", "group": "corners", "ru": "Опусти уголки рта вниз, грустно", "en": "Pull the corners of your mouth down, sad",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthFrownL": 1, "MouthFrownR": 1, "MouthSmileL": 0, "MouthSmileR": 0}},
    {"id": "frown_left", "group": "corners", "ru": "Опусти только левый уголок рта", "en": "Pull down only the left corner of your mouth",
     "hold": 6, "settle": 2.0, "labels": {"MouthFrownL": 1, "MouthFrownR": 0}},
    {"id": "frown_right", "group": "corners", "ru": "Опусти только правый уголок рта", "en": "Pull down only the right corner of your mouth",
     "hold": 6, "settle": 2.0, "labels": {"MouthFrownR": 1, "MouthFrownL": 0}},
    {"id": "stretch", "group": "corners", "ru": "Растяни рот в стороны, как в испуге", "en": "Stretch your mouth sideways, like fear",
     "hold": 4.5, "settle": 1.0, "labels": {"MouthStretchL": 1, "MouthStretchR": 1}},
    {"id": "stretch_left", "group": "corners", "ru": "Растяни рот только влево", "en": "Stretch your mouth to the left only",
     "hold": 6, "settle": 2.0, "labels": {"MouthStretchL": 1, "MouthStretchR": 0}},
    {"id": "stretch_right", "group": "corners", "ru": "Растяни рот только вправо", "en": "Stretch your mouth to the right only",
     "hold": 6, "settle": 2.0, "labels": {"MouthStretchR": 1, "MouthStretchL": 0}},
    {"id": "dimple", "group": "corners", "ru": "Вдави уголки рта, чтобы появились ямочки", "en": "Press the corners of your mouth in to make dimples",
     "hold": 5, "settle": 1.5, "labels": {"MouthDimpleL": 1, "MouthDimpleR": 1}},
    {"id": "sneer", "group": "nose", "ru": "Сморщи нос", "en": "Wrinkle your nose",
     "hold": 4.5, "settle": 1.0, "labels": {"NoseSneerL": 1, "NoseSneerR": 1}},

    {"id": "cheek_puff", "group": "cheeks", "ru": "Надуй обе щёки", "en": "Puff out both cheeks",
     "labels": {"CheekPuff": 1, "CheekPuffLeft": 1, "CheekPuffRight": 1}},
    {"id": "cheek_puff_left", "group": "cheeks", "ru": "Надуй только левую щёку", "en": "Puff out your left cheek only",
     "hold": 6, "settle": 2.0, "labels": {"CheekPuffLeft": 1, "CheekPuffRight": 0}},
    {"id": "cheek_puff_right", "group": "cheeks", "ru": "Надуй только правую щёку", "en": "Puff out your right cheek only",
     "hold": 6, "settle": 2.0, "labels": {"CheekPuffRight": 1, "CheekPuffLeft": 0}},
    {"id": "cheek_suck", "group": "cheeks", "ru": "Втяни обе щёки внутрь", "en": "Suck both cheeks in",
     "hold": 5, "settle": 1.5, "labels": {"CheekSuckLeft": 1, "CheekSuckRight": 1, "CheekPuff": 0}},
    {"id": "cheek_suck_left", "group": "cheeks", "ru": "Втяни только левую щёку", "en": "Suck in your left cheek only",
     "hold": 6, "settle": 2.0, "labels": {"CheekSuckLeft": 1, "CheekSuckRight": 0, "CheekPuff": 0}},
    {"id": "cheek_suck_right", "group": "cheeks", "ru": "Втяни только правую щёку", "en": "Suck in your right cheek only",
     "hold": 6, "settle": 2.0, "labels": {"CheekSuckRight": 1, "CheekSuckLeft": 0, "CheekPuff": 0}},

    {"id": "tongue_out", "group": "tongue", "ru": "Высуни язык прямо", "en": "Stick your tongue straight out",
     "labels": {"TongueOut": 1}},
    {"id": "tongue_left", "group": "tongue", "ru": "Язык влево", "en": "Tongue left",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 1, "TongueLeft": 1}},
    {"id": "tongue_right", "group": "tongue", "ru": "Язык вправо", "en": "Tongue right",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 1, "TongueRight": 1}},
    {"id": "tongue_up", "group": "tongue", "ru": "Язык вверх", "en": "Tongue up",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 1, "TongueUp": 1}},
    {"id": "tongue_down", "group": "tongue", "ru": "Язык вниз", "en": "Tongue down",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 1, "TongueDown": 1}},
    {"id": "tongue_roll", "group": "tongue", "optional": true, "ru": "Язык трубочкой", "en": "Roll your tongue into a tube",
     "hold": 6, "settle": 2.0, "labels": {"TongueOut": 1, "TongueRoll": 1}},

    {"id": "tongue_out_wide", "group": "tongue_jaw", "ru": "Язык прямо, рот широко открыт", "en": "Tongue straight out, mouth wide open",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 1}},
    {"id": "tongue_out_lips", "group": "tongue_jaw", "ru": "Кончик языка между губами, рот почти закрыт", "en": "Tongue tip between the lips, mouth almost closed",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 0.5}},
    {"id": "tongue_left_wide", "group": "tongue_jaw", "ru": "Язык влево, рот широко открыт", "en": "Tongue left, mouth wide open",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 1, "TongueLeft": 1}},
    {"id": "tongue_left_lips", "group": "tongue_jaw", "ru": "Язык влево из уголка рта, рот почти закрыт", "en": "Tongue out of the left corner, mouth almost closed",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 0.5, "TongueLeft": 1}},
    {"id": "tongue_right_wide", "group": "tongue_jaw", "ru": "Язык вправо, рот широко открыт", "en": "Tongue right, mouth wide open",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 1, "TongueRight": 1}},
    {"id": "tongue_right_lips", "group": "tongue_jaw", "ru": "Язык вправо из уголка рта, рот почти закрыт", "en": "Tongue out of the right corner, mouth almost closed",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 0.5, "TongueRight": 1}},
    {"id": "tongue_down_wide", "group": "tongue_jaw", "ru": "Язык вниз, рот широко открыт", "en": "Tongue down, mouth wide open",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 1, "TongueDown": 1}},
    {"id": "tongue_down_lips", "group": "tongue_jaw", "ru": "Язык вниз на нижнюю губу, рот почти закрыт", "en": "Tongue down over the lower lip, mouth almost closed",
     "hold": 4.5, "settle": 1.0, "labels": {"TongueOut": 0.5, "TongueDown": 1}},

    {"id": "emo_laugh", "group": "emotion", "ru": "Засмейся", "en": "Laugh", "hold": 5, "settle": 1.0, "labels": {}, "zero_new": false},
    {"id": "emo_surprise", "group": "emotion", "ru": "Удивление", "en": "Surprise", "hold": 4.5, "settle": 1.0, "labels": {}, "zero_new": false},
    {"id": "emo_disgust", "group": "emotion", "ru": "Отвращение", "en": "Disgust", "hold": 4.5, "settle": 1.2, "labels": {}, "zero_new": false},
    {"id": "emo_anger", "group": "emotion", "ru": "Злость, оскал", "en": "Anger, bare your teeth", "hold": 4.5, "settle": 1.2, "labels": {}, "zero_new": false},
    {"id": "emo_sad", "group": "emotion", "ru": "Грусть", "en": "Sadness", "hold": 4.5, "settle": 1.2, "labels": {}, "zero_new": false},
    {"id": "emo_smirk", "group": "emotion", "ru": "Ухмылка одним уголком", "en": "Smirk with one corner", "hold": 5, "settle": 1.5, "labels": {}, "zero_new": false},

    {"id": "speech_vowels", "group": "speech", "ru": "Медленно скажи: А, О, У, И, Э, Ы", "en": "Slowly say: A, O, U, E, I",
     "hold": 9, "settle": 0.5, "labels": {}, "zero_new": false},
    {"id": "speech_free", "group": "speech", "ru": "Поговори о чём угодно", "en": "Talk about anything",
     "hold": 12, "settle": 0.5, "labels": {}, "zero_new": false}
  ]
}
